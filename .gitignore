# Binaries
# Anchored to the repo root: these name built binaries, but unanchored they
# match any path component, and "cliproxy" was silently ignoring every new
# file added under sdk/cliproxy/ (the 49 tracked files there predate it).
/cli-proxy-api
/cliproxy
/server
*.exe


# Configuration
config.yaml
.env
.mcp.json
# Generated content
bin/*
logs/*
conv/*
temp/*
refs/*
tmp/*

# Storage backends
pgstore/*
gitstore/*
objectstore/*

# Static assets
static/*

# Authentication data
auths/*
!auths/.gitkeep

# Documentation
docs/*
AGENTS.md
CLAUDE.md
GEMINI.md

# Tooling metadata
.vscode/*
.worktrees/
.codex/*
.claude/*
.gemini/*
.serena/*
.agent/*
.agents/*
.opencode/*
.idea/*
.beads/*
